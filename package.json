{
  "name": "nuxt-jsoneditor",
  "version": "2.1.0",
  "author": {
    "name": "Alex Guzey",
    "email": "alex.guzey@gmail.com"
  },
  "private": false,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bestkolobok/nuxt-jsoneditor.git"
  },
  "bugs": {
    "url": "https://github.com/bestkolobok/nuxt-jsoneditor/issues"
  },
  "scripts": {
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "dev:build": "nuxi build playground",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "pack": "npm pack",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "semantic-release": "semantic-release",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "defu": "^6.1.7",
    "vue3-ts-jsoneditor": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "nuxt": "^4.6.4",
    "prettier": "^3.10.1",
    "semantic-release": "^26.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "funding": [
    "https://u24.gov.ua/",
    "https://savelife.in.ua/en/"
  ],
  "keywords": [
    "nuxt",
    "nuxt3",
    "nuxt4",
    "jsoneditor",
    "json editor"
  ],
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "vitest related --run"
    ]
  }
}
